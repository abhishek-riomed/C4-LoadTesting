            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// Fetch dynamic value from JMeter variable
String stockId = vars.get(&quot;stockId&quot;);

// Path to write the JSON file
String jsonFilePath = &quot;C:/NewJmeter/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/Data Files/Domain Load Testing/StockDomain/stockItemUpdate.json&quot;;

// Build the JSON content with the dynamic stockId
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;stockId\&quot;: &quot; + stockId + &quot;,\n&quot; +
&quot;  \&quot;stockCategory\&quot;: \&quot;Medication\&quot;,\n&quot; +
&quot;  \&quot;stockSubCategory\&quot;: \&quot;Vaccination\&quot;,\n&quot; +
&quot;  \&quot;stockName\&quot;: \&quot;Paraxotine 20 mg\&quot;,\n&quot; +
&quot;  \&quot;stockQueCode\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;stockQueLocalCode\&quot;: \&quot;SNC10001\&quot;,\n&quot; +
&quot;  \&quot;stockAutoGenBarcode\&quot;: \&quot;110&quot; + stockId + &quot;\&quot;,\n&quot; +
&quot;  \&quot;stockBarcode\&quot;: \&quot;110001\&quot;,\n&quot; +
&quot;  \&quot;stockItemBarcode\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;stockLettersDisplayGroupEliId\&quot;: 5897,\n&quot; +
&quot;  \&quot;stockDescription\&quot;: \&quot;added\&quot;,\n&quot; +
&quot;  \&quot;stockReadOnly\&quot;: 0,\n&quot; +
&quot;  \&quot;stockClassificationEliId\&quot;: 12952,\n&quot; +
&quot;  \&quot;stockDescOtherLang\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;stockItemMedicationDetailJson\&quot;: {\n&quot; +
&quot;    \&quot;stomdId\&quot;: 112,\n&quot; +
&quot;    \&quot;stomdUnitOfDispense\&quot;: \&quot;Quantity\&quot;,\n&quot; +
&quot;    \&quot;stomdForm\&quot;: \&quot;\&quot;,\n&quot; +
&quot;    \&quot;stomdDose\&quot;: \&quot;20mg\&quot;,\n&quot; +
&quot;    \&quot;stomdFrequency\&quot;: \&quot;At Night\&quot;,\n&quot; +
&quot;    \&quot;stomdRoute\&quot;: \&quot;Orally\&quot;,\n&quot; +
&quot;    \&quot;stomdDuration\&quot;: \&quot;30\&quot;,\n&quot; +
&quot;    \&quot;stomdDilutant\&quot;: \&quot;\&quot;,\n&quot; +
&quot;    \&quot;stomdVolume\&quot;: \&quot;\&quot;,\n&quot; +
&quot;    \&quot;stomdDoseMultiplier\&quot;: \&quot;bsa\&quot;,\n&quot; +
&quot;    \&quot;stomdDoseMultiplierAgeStart\&quot;: \&quot;\&quot;,\n&quot; +
&quot;    \&quot;stomdDoseMultiplierAgeEnd\&quot;: \&quot;\&quot;,\n&quot; +
