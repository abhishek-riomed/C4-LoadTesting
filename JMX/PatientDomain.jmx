                  <stringProp name="Argument.value">{&quot;patTitle&quot;:&quot;&quot;,&quot;patGenderEliId&quot;:&quot;&quot;,&quot;patGenderEliText&quot;:&quot;&quot;,&quot;patPractisingReligion&quot;:&quot;0&quot;,&quot;patLanguage&quot;:&quot;&quot;,&quot;patSurname&quot;:&quot;Riomedtest${uniquePatientId}&quot;,&quot;patSexAtBirth&quot;:&quot;M&quot;,&quot;patTownOfBirth&quot;:&quot;&quot;,&quot;patNeedInterpreterAtAppointments&quot;:&quot;0&quot;,&quot;patFirstname&quot;:&quot;Atul${uniquePatientId}&quot;,&quot;patMaritalStatus&quot;:&quot;&quot;,&quot;patCountyOfBirth&quot;:&quot;&quot;,&quot;patCountryOfBirth&quot;:&quot;&quot;,&quot;patType&quot;:&quot;&quot;,&quot;patMiddlename&quot;:&quot;&quot;,&quot;patCurrentlyPregnant&quot;:&quot;0&quot;,&quot;patHospitalRef&quot;:&quot;&quot;,&quot;patMaidenName&quot;:&quot;&quot;,&quot;patEthnicityText&quot;:&quot;&quot;,&quot;patNationality&quot;:&quot;&quot;,&quot;patNhsRef&quot;:&quot;&quot;,&quot;patNameOtherLang&quot;:&quot;&quot;,&quot;patOccupation&quot;:&quot;&quot;,&quot;patRegisteredDisabled&quot;:&quot;0&quot;,&quot;patIdentifier&quot;:&quot;&quot;,&quot;patDob&quot;:&quot;${patientDob}&quot;,&quot;patReligion&quot;:&quot;&quot;,&quot;patDisabilityNote&quot;:&quot;&quot;,&quot;patNeededAssistanceAtAppointments&quot;:&quot;&quot;,&quot;patNotes&quot;:&quot;&quot;,&quot;patPasid&quot;:&quot;&quot;,&quot;patPrisoner&quot;:&quot;&quot;,&quot;patBloodGroup&quot;:&quot;&quot;,&quot;patDod&quot;:&quot;&quot;,&quot;patBanned&quot;:&quot;&quot;,&quot;patSexuality&quot;:&quot;&quot;,&quot;patPatientwebAccountLocked&quot;:&quot;0&quot;,&quot;patRegisteredWithPatientweb&quot;:&quot;&quot;,&quot;primaryDisability&quot;:[],&quot;patIsBabyBornInThisHospital&quot;:&quot;&quot;,&quot;patSexualOrientationEliId&quot;:&quot;&quot;,&quot;patBarcode&quot;:null,&quot;patMothername&quot;:null,&quot;patMobile&quot;:&quot;${patientMobile}&quot;,&quot;patEmail&quot;:&quot;${patientEmail}&quot;,&quot;patId&quot;:null,&quot;patEstId&quot;:&quot;2&quot;,&quot;primaryDisablity&quot;:{},&quot;patientIdentifierJsonList&quot;:[{&quot;pidTypeEliId&quot;:184,&quot;pidPatId&quot;:null,&quot;pidValue&quot;:&quot;89562314&quot;,&quot;pidIssuingCountryCode&quot;:&quot;&quot;}]}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Generate unique patient ID using current timestamp
def uniqueId = System.currentTimeMillis()

// Set unique Firstname and Surname
vars.put(&quot;uniquePatientId&quot;, uniqueId.toString())

// Generate random DOB (DD/MM/YYYY format)
def random = new Random()

int year = 1980 + random.nextInt(25)   // 1980-2004
int month = 1 + random.nextInt(12)
int day = 1 + random.nextInt(28)

String patientDob = String.format(&quot;%02d/%02d/%d&quot;, day, month, year)

vars.put(&quot;patientDob&quot;, patientDob)


// Generate unique email
String email = &quot;atul${uniqueId}@testmail.com&quot;
vars.put(&quot;patientEmail&quot;, email)


// Generate unique mobile number (10 digits)
String mobile = &quot;9&quot; + uniqueId.toString().substring(3, 12)
vars.put(&quot;patientMobile&quot;, mobile)


// Optional: Print values in JMeter log for verification
log.info(&quot;Patient Firstname: Atul${uniqueId}&quot;)
log.info(&quot;Patient Surname: Riomedtest${uniqueId}&quot;)
log.info(&quot;Patient DOB: ${patientDob}&quot;)
log.info(&quot;Patient Email: ${email}&quot;)
log.info(&quot;Patient Mobile: ${mobile}&quot;)</stringProp>
            </JSR223PreProcessor>
