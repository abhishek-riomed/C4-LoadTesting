            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// Extract dynamic values from previous extractors
String pacrId   = vars.get(&quot;PatientScans_pacrId&quot;);
String patId    = vars.get(&quot;PatientScans_patId&quot;);
String patRefId = vars.get(&quot;PatientScans_patRefId&quot;);
String patSgrId = vars.get(&quot;PatientScans_patSgrId&quot;);

// Set the path where the JSON file will be saved
String filePath = &quot;C:/NewJmeter/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/Data Files/Domain Load Testing/Set3/scanUpdateData.json&quot;;

// Build the JSON string with extracted values
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;patientClinicalRecordJson\&quot;: {\n&quot; +
&quot;    \&quot;pacrId\&quot;: &quot; + pacrId + &quot;,\n&quot; +
&quot;    \&quot;pacrPatId\&quot;: \&quot;&quot; + patId + &quot;\&quot;,\n&quot; +
&quot;    \&quot;pacrRefId\&quot;: \&quot;&quot; + patRefId + &quot;\&quot;,\n&quot; +
&quot;    \&quot;pacrPrivate\&quot;: 0,\n&quot; +
&quot;    \&quot;pacrQueCode\&quot;: \&quot;1126641000000100\&quot;,\n&quot; +
&quot;    \&quot;pacrQueName\&quot;: \&quot;DEXA of left hip\&quot;,\n&quot; +
&quot;    \&quot;pacrClinicDate\&quot;: \&quot;10/04/2025\&quot;,\n&quot; +
&quot;    \&quot;pacrdSharedPrivateServiceRecords\&quot;: 0,\n&quot; +
&quot;    \&quot;pacrCategory\&quot;: \&quot;Patient Scan\&quot;,\n&quot; +
&quot;    \&quot;pacrSgrId\&quot;: \&quot;&quot; + patSgrId + &quot;\&quot;\n&quot; +
&quot;  },\n&quot; +
&quot;  \&quot;patientScanJson\&quot;: {\n&quot; +
&quot;    \&quot;pascnScanTypeEliId\&quot;: 7185,\n&quot; +
&quot;    \&quot;pascnScanDate\&quot;: null,\n&quot; +
&quot;    \&quot;pascnSiteName\&quot;: \&quot;Abdomen\&quot;,\n&quot; +
&quot;    \&quot;pascnTScore\&quot;: \&quot;1\&quot;,\n&quot; +
&quot;    \&quot;pascnZScore\&quot;: \&quot;1\&quot;,\n&quot; +
&quot;    \&quot;pascnBmdScore\&quot;: \&quot;1\&quot;,\n&quot; +
&quot;    \&quot;pascnNotes\&quot;: \&quot;updated\&quot;\n&quot; +
&quot;  },\n&quot; +
&quot;  \&quot;answeredQuestionExtraDetailsJson\&quot;: [],\n&quot; +
&quot;  \&quot;answeredQuestionSectionExtraDetailsJson\&quot;: [],\n&quot; +
&quot;  \&quot;searchQuestionLinkingJson\&quot;: []\n&quot; +
&quot;}&quot;;

// Write JSON to file
File jsonFile = new File(filePath);
FileUtils.writeStringToFile(jsonFile, jsonContent, &quot;UTF-8&quot;);

// Set the file path as a variable for use in HTTP multipart request
vars.put(&quot;scanJsonPath&quot;, filePath);
</stringProp>
