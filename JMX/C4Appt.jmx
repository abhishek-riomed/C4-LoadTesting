      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">// Get the HTTP method (e.g., GET, POST, etc.)
String method = sampler.getMethod();

// Get the base URL without query parameters
String baseUrl = sampler.getUrl().getProtocol() + &quot;://&quot; + sampler.getUrl().getHost() + sampler.getUrl().getPath();

// Combine method and base URL to form the label
String updatedLabel = method + &quot; &quot; + baseUrl;

// Set the sampler name to the new label
sampler.setName(updatedLabel);
</stringProp>
      </JSR223PreProcessor>
