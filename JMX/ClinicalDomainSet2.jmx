            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import org.json.JSONObject;

// Get the response as a string
String response = prev.getResponseDataAsString();

// Parse JSON
JSONObject jsonResponse = new JSONObject(response);
String patDob = jsonResponse.getJSONObject(&quot;entity&quot;).getJSONArray(&quot;patientsList&quot;).getJSONObject(0).getString(&quot;patDob&quot;);

// Format date
String[] dateParts = patDob.split(&quot;-&quot;);
String formattedDate = dateParts[2] + &quot;/&quot; + dateParts[1] + &quot;/&quot; + dateParts[0];

// Store in JMeter variable
vars.put(&quot;patDobFormatted&quot;, formattedDate);</stringProp>
            </BeanShellPostProcessor>
