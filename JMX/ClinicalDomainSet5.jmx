            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// Get dynamic value from JMeter variable
String pacPatId = vars.get(&quot;PatientConsent_patId&quot;);

// Set the path to write JSON file
String filePath = &quot;C:/NewJmeter/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/Data Files/Domain Load Testing/Set5 DataFiles/consentData.json&quot;;


// Define full JSON content with placeholder for pacPatId
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;pacPatId\&quot;: &quot; + pacPatId + &quot;,\n&quot; +
&quot;  \&quot;pacConsentGivenBy\&quot;: \&quot;Smith jeon (Next Of Kin)\&quot;,\n&quot; +
&quot;  \&quot;pacConsentType\&quot;: \&quot;Cellma Trainer\&quot;,\n&quot; +
&quot;  \&quot;pacConsentStatus\&quot;: \&quot;Given\&quot;,\n&quot; +
&quot;  \&quot;pacConsentStartDate\&quot;: \&quot;13/05/2025\&quot;,\n&quot; +
&quot;  \&quot;pacConsentEndDate\&quot;: \&quot;13/05/2025\&quot;,\n&quot; +
&quot;  \&quot;pacConsentNotes\&quot;: \&quot;added consent\&quot;,\n&quot; +
&quot;  \&quot;pacConsentIsValid\&quot;: 1,\n&quot; +
&quot;  \&quot;pacIsDigitalCosent\&quot;: 0,\n&quot; +
&quot;  \&quot;patientDigitalConsentDetailJson\&quot;: \&quot;{\\\&quot;patientDetails\\\&quot;:{\\\&quot;patSurname\\\&quot;:\\\&quot;Riomedtest\\\&quot;,\\\&quot;patFirstName\\\&quot;:\\\&quot;Ronak\\\&quot;,\\\&quot;patDateOfBirth\\\&quot;:\\\&quot;01/12/2013\\\&quot;,\\\&quot;patGender\\\&quot;:\\\&quot;M\\\&quot;,\\\&quot;patNhsNumber\\\&quot;:\\\&quot;555 777 \\\&quot;,\\\&quot;patPid\\\&quot;:\\\&quot;ID34568\\\&quot;,\\\&quot;specialRequirements\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;proposedProcedures\\\&quot;:{},\\\&quot;briefExplanationMedicalTerm\\\&quot;:\\\&quot;\\\&quot;},\\\&quot;statementOfHealthProfessional\\\&quot;:{\\\&quot;explainedIntendedBenefits\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;significantUnavoidableRisks\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;extraProcedures\\\&quot;:{\\\&quot;bloodTransfusion\\\&quot;:false,\\\&quot;details\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;proceduresChecked\\\&quot;:false,\\\&quot;otherProcedures\\\&quot;:[{}, {\\\&quot;details\\\&quot;:\\\&quot;\\\&quot;}]},\\\&quot;providedInformation\\\&quot;:false,\\\&quot;details\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;involvedProcedureDetails\\\&quot;:{\\\&quot;generalAnaesthesia\\\&quot;:false,\\\&quot;localAnaesthesia\\\&quot;:false,\\\&quot;sedation\\\&quot;:false,\\\&quot;responsibleHealthProfessional\\\&quot;:{\\\&quot;name\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;jobTitle\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;registrationNumber\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;signature\\\&quot;:\\\&quot;\\\&quot;},\\\&quot;healthProfessionalName\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;jobTitle\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;date\\\&quot;:\\\&quot;13/05/2025\\\&quot;}},\\\&quot;statementOfInterpreter\\\&quot;:{\\\&quot;signature\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;interpreterName\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;date\\\&quot;:\\\&quot;13/05/2025\\\&quot;},\\\&quot;statementOfParent\\\&quot;:{\\\&quot;details\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;removelOfTissueOrBloodDuringOperation\\\&quot;:\\\&quot;Yes\\\&quot;,\\\&quot;forResearchInConnectionWithDisorders\\\&quot;:\\\&quot;Yes\\\&quot;,\\\&quot;forScientificOrMedicalInformation\\\&quot;:\\\&quot;Yes\\\&quot;,\\\&quot;parentDetails\\\&quot;:{\\\&quot;patientSignature\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;patientName\\\&quot;:\\\&quot;Ronak Riomedtest\\\&quot;,\\\&quot;date\\\&quot;:null},\\\&quot;witnessDetails\\\&quot;:{\\\&quot;patientSignature\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;patientName\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;date\\\&quot;:null}},\\\&quot;confirmationOfConsent\\\&quot;:{\\\&quot;healthProfessional\\\&quot;:{\\\&quot;signature\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;jobTitle\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;date\\\&quot;:null},\\\&quot;parent\\\&quot;:{\\\&quot;signature\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;Ronak Riomedtest\\\&quot;,\\\&quot;date\\\&quot;:null}},\\\&quot;withdrawalOfConsentDetails\\\&quot;:{\\\&quot;patientName\\\&quot;:\\\&quot;Ronak Riomedtest\\\&quot;,\\\&quot;date\\\&quot;:null}}\&quot;\n&quot; +
&quot;}&quot;;

// Save the JSON content to file
File jsonFile = new File(filePath);
FileUtils.writeStringToFile(jsonFile, jsonContent, &quot;UTF-8&quot;);

// Set the file path as a JMeter variable
vars.put(&quot;consentJsonPath&quot;, filePath);
</stringProp>
            </BeanShellPreProcessor>
