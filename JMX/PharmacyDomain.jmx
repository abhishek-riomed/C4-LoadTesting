            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// Get extracted variables from JMeter
String mediId = vars.get(&quot;Pharmacy_mediId&quot;);       // e.g., 13346
String mediSgrId = vars.get(&quot;Pharmacy_patSgrId&quot;);  // e.g., 97772
String mediPatId = vars.get(&quot;Pharmacy_patId&quot;);     // e.g., 1001

// Updated file path
String filePath = &quot;../Datafiles/PharmacyDomain/prescriptionData.json&quot;;

// Construct JSON string
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;mediId\&quot;: [&quot; + mediId + &quot;],\n&quot; +
&quot;  \&quot;mediSgrId\&quot;: \&quot;&quot; + mediSgrId + &quot;\&quot;,\n&quot; +
&quot;  \&quot;mediPatId\&quot;: &quot; + mediPatId + &quot;,\n&quot; +
&quot;  \&quot;paprePrescribedBy\&quot;: \&quot;Mr Jayant Testcellma\&quot;,\n&quot; +
&quot;  \&quot;papreCode\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;papreNumberItemsOnPrescription\&quot;: 1,\n&quot; +
&quot;  \&quot;stockLocationId\&quot;: 4,\n&quot; +
&quot;  \&quot;paprePrescriptionGroup\&quot;: \&quot;IP prescription\&quot;,\n&quot; +
&quot;  \&quot;paprdExternalPharmacyEliId\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;paprdForClinicId\&quot;: 3,\n&quot; +
&quot;  \&quot;papreClinicDate\&quot;: \&quot;21/05/2025\&quot;,\n&quot; +
&quot;  \&quot;paprdNotes\&quot;: \&quot;\&quot;\n&quot; +
&quot;}&quot;;

// Save JSON to file
File jsonFile = new File(filePath);
FileUtils.writeStringToFile(jsonFile, jsonContent, &quot;UTF-8&quot;);

// Save path to variable for multipart use
vars.put(&quot;prescriptionJsonPath&quot;, filePath);
</stringProp>
            </BeanShellPreProcessor>
