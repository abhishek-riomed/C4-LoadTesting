quot;:&quot;2&quot;,&quot;primaryDisablity&quot;:{},&quot;patientIdentifierJsonList&quot;:[{&quot;pidTypeEliId&quot;:184,&quot;pidPatId&quot;:null,&quot;pidValue&quot;:&quot;89562314&quot;,&quot;pidIssuingCountryCode&quot;:&quot;&quot;}]}</stringProp>
