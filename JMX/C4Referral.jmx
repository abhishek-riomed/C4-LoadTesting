          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Generate unique patient ID using current timestamp
def uniqueId = System.currentTimeMillis()

// Set unique Firstname and Surname
vars.put(&quot;uniquePatientId&quot;, uniqueId.toString())

// Generate random DOB (DD/MM/YYYY format)
def random = new Random()

int year = 1980 + random.nextInt(25)   // 1980-2004
int month = 1 + random.nextInt(12)
int day = 1 + random.nextInt(28)

String patientDob = String.format(&quot;%02d/%02d/%d&quot;, day, month, year)

vars.put(&quot;patientDob&quot;, patientDob)


// Generate unique email
String email = &quot;atul${uniqueId}@testmail.com&quot;
vars.put(&quot;patientEmail&quot;, email)


// Generate unique mobile number (10 digits)
String mobile = &quot;9&quot; + uniqueId.toString().substring(3, 12)
vars.put(&quot;patientMobile&quot;, mobile)


// Optional: Print values in JMeter log for verification
log.info(&quot;Patient Firstname: Atul${uniqueId}&quot;)
log.info(&quot;Patient Surname: Riomedtest${uniqueId}&quot;)
log.info(&quot;Patient DOB: ${patientDob}&quot;)
log.info(&quot;Patient Email: ${email}&quot;)
log.info(&quot;Patient Mobile: ${mobile}&quot;)</stringProp>
            </JSR223PreProcessor>
