            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// Get dynamic values from JMeter variables
String patletPatId = vars.get(&quot;Letter_patId&quot;);
String patletRefId = vars.get(&quot;Letter_patRefId&quot;);
String patletSgrId = vars.get(&quot;Letter_patSgrId&quot;);

// Define path to write JSON file (with forward slashes)
String filePath = &quot;C:/NewJmeter/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/Data Files/Domain Load Testing/letter/letterData.json&quot;;

// Create full JSON string with dynamic injection
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;patletId\&quot;: null,\n&quot; +
&quot;  \&quot;patletSgrId\&quot;: &quot; + patletSgrId + &quot;,\n&quot; +
&quot;  \&quot;patletRefId\&quot;: &quot; + patletRefId + &quot;,\n&quot; +
&quot;  \&quot;patletPatId\&quot;: &quot; + patletPatId + &quot;,\n&quot; +
&quot;  \&quot;patletLettmplId\&quot;: 15,\n&quot; +
&quot;  \&quot;patletName\&quot;: \&quot;Summary Letter Patient\&quot;,\n&quot; +
&quot;  \&quot;patletType\&quot;: \&quot;Discharge Summary\&quot;,\n&quot; +
&quot;  \&quot;patletStatus\&quot;: \&quot;draft\&quot;,\n&quot; +
&quot;  \&quot;patletJson\&quot;: \&quot;{\\\&quot;letterData\\\&quot;:{\\\&quot;letterName\\\&quot;:\\\&quot;Summary Letter Patient\\\&quot;,\\\&quot;letterType\\\&quot;:\\\&quot;Discharge Summary\\\&quot;,\\\&quot;letterLocation\\\&quot;:7595,\\\&quot;recipient\\\&quot;:{\\\&quot;id\\\&quot;:\\\&quot;1\\\&quot;,\\\&quot;label\\\&quot;:\\\&quot;GP\\\&quot;,\\\&quot;recipient\\\&quot;:\\\&quot;GP\\\&quot;},\\\&quot;showLettersInPatient\\\&quot;:false,\\\&quot;pageSize\\\&quot;:{\\\&quot;id\\\&quot;:1,\\\&quot;label\\\&quot;:\\\&quot;A1\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;a1\\\&quot;,\\\&quot;width\\\&quot;:\\\&quot;59.4\\\&quot;,\\\&quot;height\\\&quot;:\\\&quot;84.1\\\&quot;},\\\&quot;letterMargin\\\&quot;:{\\\&quot;id\\\&quot;:1,\\\&quot;label\\\&quot;:\\\&quot;Normal\\\&quot;,\\\&quot;name\\\&quot;:\\\&quot;normal\\\&quot;},\\\&quot;top\\\&quot;:2.54,\\\&quot;bottom\\\&quot;:2.54,\\\&quot;left\\\&quot;:2.54,\\\&quot;right\\\&quot;:2.54,\\\&quot;assessmentCreate\\\&quot;:true},\\\&quot;letterForm\\\&quot;:[{\\\&quot;id\\\&quot;:\\\&quot;1747711179690\\\&quot;,\\\&quot;label\\\&quot;:\\\&quot;Letter Header\\\&quot;,\\\&quot;isEditing\\\&quot;:false,\\\&quot;objectType\\\&quot;:\\\&quot;letterHeader\\\&quot;,\\\&quot;properties\\\&quot;:{\\\&quot;size\\\&quot;:12,\\\&quot;headerTop\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;headerHeight\\\&quot;:\\\&quot;2.3\\\&quot;,\\\&quot;requiredPage\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;justifyContent\\\&quot;:\\\&quot;space-between\\\&quot;,\\\&quot;letterHeaderLayout\\\&quot;:\\\&quot;Logo and Date\\\&quot;},\\\&quot;componentData\\\&quot;:[{\\\&quot;id\\\&quot;:\\\&quot;letterHeaderLogo\\\&quot;,\\\&quot;label\\\&quot;:\\\&quot;Logo\\\&quot;,\\\&quot;objectType\\\&quot;:\\\&quot;imageBox\\\&quot;,\\\&quot;properties\\\&quot;:{\\\&quot;size\\\&quot;:10,\\\&quot;width\\\&quot;:50,\\\&quot;height\\\&quot;:50,\\\&quot;justifyContent\\\&quot;:\\\&quot;flex-start\\\&quot;}},{\\\&quot;id\\\&quot;:\\\&quot;letterHeaderDate\\\&quot;,\\\&quot;value\\\&quot;:\\\&quot;20/05/2025\\\&quot;,\\\&quot;adcCode\\\&quot;:\\\&quot;TodaysDate\\\&quot;,\\\&quot;adcName\\\&quot;:\\\&quot;Today&apos;s Date\\\&quot;,\\\&quot;tagType\\\&quot;:\\\&quot;typography\\\&quot;,\\\&quot;objectType\\\&quot;:\\\&quot;tag\\\&quot;,\\\&quot;properties\\\&quot;:{\\\&quot;font\\\&quot;:\\\&quot;&apos;Times New Roman&apos;, serif\\\&quot;,\\\&quot;size\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;fontSize\\\&quot;:\\\&quot;12\\\&quot;,\\\&quot;alignItem\\\&quot;:\\\&quot;start\\\&quot;,\\\&quot;fontStyle\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;fontWeight\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;lineHeight\\\&quot;:\\\&quot;\\\&quot;,\\\&quot;lineSpacing\\\&quot;:\\\&quot;1.0\\\&quot;,\\\&quot;paddingLeft\\\&quot;:\\\&quot;3px\\\&quot;,\\\&quot;paddingRight\\\&quot;:\\\&quot;0px\\\&quot;,\\\&quot;justifyContent\\\&quot;:\\\&quot;flex-start\\\&quot;,\\\&quot;textDecoration\\\&quot;:\\\&quot;\\\&quot;}}]}]}\&quot;,\n&quot; +
&quot;  \&quot;patletdHighlySensitive\&quot;: 1,\n&quot; +
&quot;  \&quot;patletLetterDate\&quot;: \&quot;23/05/2025\&quot;,\n&quot; +
&quot;  \&quot;patletdStartDate\&quot;: \&quot;23/05/2025\&quot;,\n&quot; +
&quot;  \&quot;patletdEndDate\&quot;: \&quot;23/05/2025\&quot;,\n&quot; +
&quot;  \&quot;patletdRequestApprovalBy\&quot;: null\n&quot; +
&quot;}&quot;;

// Write the JSON string to file
File jsonFile = new File(filePath);
FileUtils.writeStringToFile(jsonFile, jsonContent, &quot;UTF-8&quot;);

// Set file path as JMeter variable
vars.put(&quot;letterJsonPath&quot;, filePath);</stringProp>
