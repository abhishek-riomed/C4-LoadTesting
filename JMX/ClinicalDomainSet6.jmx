            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat

// 🔹 Read extracted variables (from a previous request or CSV)
String patId = vars.get(&quot;Communicationl_patId&quot;)       // from extractor or CSV
String patientEmail = &quot;c4@mailinator.com&quot;              // static or dynamic if needed
String patientMobile = vars.get(&quot;Communicationl_mobile&quot;) ?: &quot;&quot; // optional mobile
String typeOfCommunication = &quot;email&quot;

// 🔹 Generate today&apos;s date in dd/MM/yyyy format
def today = new Date()
def sdf = new SimpleDateFormat(&quot;dd/MM/yyyy&quot;)
String communicationDate = sdf.format(today)

// 🔹 Build dynamic header and content
String header = &quot;Appointments scheduled for &quot; + sdf.format(today + 1)
String content = &quot;You have an appointment tomorrow.&quot;

// 🔹 Store all into JMeter variables for reuse in the form
vars.put(&quot;patId&quot;, patId)
vars.put(&quot;patientEmail&quot;, patientEmail)
vars.put(&quot;patientMobile&quot;, patientMobile)
vars.put(&quot;communicationDate&quot;, communicationDate)
vars.put(&quot;typeOfCommunication&quot;, typeOfCommunication)
vars.put(&quot;header&quot;, header)
vars.put(&quot;content&quot;, content)

// (Optional) Log values in JMeter console
log.info(&quot;📩 Dynamic Communication Data: patId=&quot; + patId + &quot;, header=&quot; + header)</stringProp>
            </JSR223PreProcessor>
