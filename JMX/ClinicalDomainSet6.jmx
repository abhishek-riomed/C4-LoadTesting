            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// 1️⃣ Extract JMeter variable
String patId = vars.get(&quot;Communicationl_patId&quot;);
if (patId == null || patId.trim().equals(&quot;&quot;)) {
    patId = &quot;0&quot;; // fallback
}

// 2️⃣ Build JSON content exactly as API expects
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;typeOfCommunication\&quot;: \&quot;email\&quot;,\n&quot; +
&quot;  \&quot;patientCommunicationJsonList\&quot;: [\n&quot; +
&quot;    {\n&quot; +
&quot;      \&quot;patId\&quot;: \&quot;&quot; + patId + &quot;\&quot;,\n&quot; +
&quot;      \&quot;email\&quot;: \&quot;c4@mailinator.com\&quot;,\n&quot; +
&quot;      \&quot;mobileNumber\&quot;: \&quot;\&quot;,\n&quot; +
&quot;      \&quot;communicationDate\&quot;: \&quot;14/05/2025\&quot;,\n&quot; +
&quot;      \&quot;header\&quot;: \&quot;Appointments scheduled for 15 May 2025\&quot;,\n&quot; +
&quot;      \&quot;content\&quot;: \&quot;You have an Appointment tomorrow.\&quot;\n&quot; +
&quot;    }\n&quot; +
&quot;  ]\n&quot; +
&quot;}&quot;;

// 3️⃣ Define path
String filePath = &quot;C:/NewJmeter/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/Data Files/communicationData.json&quot;;

// 4️⃣ Write file
File jsonFile = new File(filePath);
FileUtils.writeStringToFile(jsonFile, jsonContent, &quot;UTF-8&quot;);

// 5️⃣ Pass to next sampler
vars.put(&quot;communicationJsonPath&quot;, filePath);

// Log
log.info(&quot;✅ JSON file created at: &quot; + filePath);
log.info(&quot;📦 JSON content:\n&quot; + jsonContent);
</stringProp>
            </BeanShellPreProcessor>
