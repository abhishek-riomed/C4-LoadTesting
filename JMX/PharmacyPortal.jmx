            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;
import java.io.File;

// === Extracted JMeter variables ===
String mediId = vars.get(&quot;PharmacyPortal_MediId&quot;);          // e.g., 26250
String mediSgrId = vars.get(&quot;PatientVisit_patSgrId&quot;);      // e.g., 281062
String mediPatId = vars.get(&quot;PharmacyPortal_patId&quot;);         // e.g., 88670
String prescribedBy = &quot;Abhishek Dhane&quot;;                // Hardcoded or extract if dynamic
String clinicDate = &quot;28/07/2025&quot;;                      // Hardcoded or extract if dynamic

// === Define file path to save JSON ===
String filePath = &quot;C:/NewJmeter/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/Data Files/Domain Load Testing/PharmacyPortal/prescriptionData.json&quot;;
// === Construct JSON content ===
String jsonContent = &quot;{\n&quot; +
&quot;  \&quot;mediId\&quot;: [&quot; + mediId + &quot;],\n&quot; +
&quot;  \&quot;mediSgrId\&quot;: &quot; + mediSgrId + &quot;,\n&quot; +
&quot;  \&quot;mediPatId\&quot;: &quot; + mediPatId + &quot;,\n&quot; +
&quot;  \&quot;paprePrescribedBy\&quot;: \&quot;&quot; + prescribedBy + &quot;\&quot;,\n&quot; +
&quot;  \&quot;papreCode\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;papreNumberItemsOnPrescription\&quot;: 1,\n&quot; +
&quot;  \&quot;paprePrescriptionGroup\&quot;: \&quot;IP prescription\&quot;,\n&quot; +
&quot;  \&quot;stockLocationId\&quot;: 4,\n&quot; +
&quot;  \&quot;paprdExternalPharmacyEliId\&quot;: \&quot;\&quot;,\n&quot; +
&quot;  \&quot;papreClinicDate\&quot;: \&quot;&quot; + clinicDate + &quot;\&quot;,\n&quot; +
&quot;  \&quot;paprdNotes\&quot;: \&quot;\&quot;\n&quot; +
&quot;}&quot;;

// === Save JSON content to file ===
File jsonFile = new File(filePath);
FileUtils.writeStringToFile(jsonFile, jsonContent, &quot;UTF-8&quot;);

// === Set variable for file path to use in multipart request ===
vars.put(&quot;prescriptionJsonPath&quot;, filePath);
</stringProp>
            </BeanShellPreProcessor>
